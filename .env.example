# Auth0 Universal Login
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# API identifier for bearer access tokens. Required for non-browser clients.
AUTH0_AUDIENCE=https://policyai.example/api

# Auth0 subject that should become an organization admin on bootstrap.
POLICYAI_ADMIN_SUB=

# Postgres with pgvector. Use a Tiger Data Cloud connection string in deployment.
DATABASE_URL=postgres://policyai:policyai@127.0.0.1:54329/policyai

# OpenAI. text-embedding-3-small is 1536 dimensions and matches the vector column.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4o-mini

# Auth0 FGA. Leave the client credentials empty when using the local OpenFGA service.
FGA_API_URL=http://127.0.0.1:8080
FGA_STORE_ID=
FGA_MODEL_ID=
FGA_API_TOKEN_ISSUER=auth.fga.dev
FGA_API_AUDIENCE=https://api.us1.fga.dev/
FGA_CLIENT_ID=
FGA_CLIENT_SECRET=
